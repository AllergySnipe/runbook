# Copy to .env and fill in. .env is gitignored — never commit real values.
# In production these are set in the Render dashboard (Environment) instead.

# OpenRouter (OpenAI-compatible). Free models — see ADR-0009. Key: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Jina — hosted embeddings + reranking (ADR-0013). New key = 10M free tokens, no
# card: jina.ai (top-right "API"). Retrieval fails clearly without it.
JINA_API_KEY=jina_your-key-here

# Optional overrides (defaults live in src/runbook/config.py)
# TRIAGE_MODEL=z-ai/glm-5.2:free
# DIAGNOSIS_MODEL=z-ai/glm-5.2:free
# JUDGE_MODEL=minimax/minimax-m3:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Semantic cache + routing (ADR-0014) — on by default; set false to disable
# CACHE_ENABLED=true
# CACHE_SIMILARITY_THRESHOLD=0.97
# CACHE_TTL_S=3600
# ROUTING_ENABLED=true

# Langfuse — LLM tracing (ADR-0017). Free "hobby" project, no card: langfuse.com/cloud
# → project Settings → API Keys. Absent keys = tracing is a silent no-op.
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US = https://us.cloud.langfuse.com
# LANGFUSE_ENABLED=true
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_ENVIRONMENT=development   # render.yaml sets this to "production" in prod

# Postgres (Neon). Get both from `neon env pull` or the Neon dashboard.
# DATABASE_URL           — pooled (host has "-pooler"); used by the app.
# DATABASE_URL_UNPOOLED  — direct; used by the migration applier.
DATABASE_URL=postgresql://user:pass@host-pooler.REGION.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.REGION.aws.neon.tech/dbname?sslmode=require
